# Application/deployment settings. Set these in the web server / PHP-FPM
# environment. Do not commit real values.
APP_ENV=production
APP_TIMEZONE=Africa/Nairobi
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=php_admin_panel
DB_USER=shop_app
DB_PASS=replace-with-a-long-secret

# One-time utility guards. Delete install.php and migrate.php after use.
INSTALL_TOKEN=replace-with-a-long-random-token
MIGRATION_TOKEN=replace-with-a-long-random-token

# Safaricom Daraja credentials and callback settings.
# sandbox or production
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
# Optional: defaults to MPESA_SHORTCODE. Use the till/paybill party B value.
MPESA_PARTY_B=
# CustomerPayBillOnline or CustomerBuyGoodsOnline
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_PASSKEY=

# Public HTTPS URL reachable by Safaricom, including this project file.
# Example: https://shop.example.com/mpesa_callback.php
MPESA_CALLBACK_URL=

# Long random secret used as an application-level callback guard.
# Example generation: php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
MPESA_CALLBACK_TOKEN=

# Optional HTTP timeout in seconds.
MPESA_TIMEOUT_SECONDS=20

# Optional admin-only reversal/refund credentials.
# SecurityCredential must be generated with Safaricom's public certificate;
# never put a plaintext initiator password here.
MPESA_INITIATOR_NAME=
MPESA_SECURITY_CREDENTIAL=
MPESA_REVERSAL_RESULT_URL=https://shop.example.com/mpesa_reversal_callback.php
MPESA_REVERSAL_TIMEOUT_URL=https://shop.example.com/mpesa_reversal_callback.php
# Optional; defaults to MPESA_CALLBACK_TOKEN.
MPESA_REVERSAL_CALLBACK_TOKEN=
# Usually 4 for an organization shortcode.
MPESA_REVERSAL_RECEIVER_IDENTIFIER_TYPE=4
